# Server-side URL used by the same-origin /api/backend proxy (no trailing slash).
# Browser code no longer calls this URL directly, avoiding CORS preflights.
API_URL=https://your-api-domain.com

# Backward-compatible proxy fallback when API_URL is not configured.
NEXT_PUBLIC_API_URL=https://your-api-domain.com

# Server-only key used by Next API routes for protected backend mutations.
# Must match SCE_ADMIN_API_KEY on the API service. Do not prefix with NEXT_PUBLIC_.
SCE_ADMIN_API_KEY=replace-with-the-api-admin-key
