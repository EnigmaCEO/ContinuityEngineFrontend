# URL of the SCE API backend (no trailing slash).
# In development this defaults to http://127.0.0.1:8000 if unset.
NEXT_PUBLIC_API_URL=https://your-api-domain.com

# Server-only key used by Next API routes for protected backend mutations.
# Must match SCE_ADMIN_API_KEY on the API service. Do not prefix with NEXT_PUBLIC_.
SCE_ADMIN_API_KEY=replace-with-the-api-admin-key
